# ---------------------------------------------------------------------------
# Banco de dados PostgreSQL (Neon recomendado em produção)
# Use a URL com pooling da Neon em produção e SSL habilitado.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# URL pública da loja, sem barra final. Precisa ser HTTPS em produção.
# Também é usada na validação de origem (CSRF), nos links de e-mail e nos metadados.
APP_URL="http://localhost:3000"

# Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-um-segredo-aleatorio-com-48-bytes"

# Chave base64 de exatamente 32 bytes (AES-256-GCM) para segredos como TOTP.
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY="troque-por-uma-chave-base64-de-32-bytes"

# Armazenamento dos arquivos digitais.
# Desenvolvimento local: local. Produção na Vercel: vercel-blob (privado).
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR=".private-storage"

# Vercel Blob (obrigatório quando STORAGE_DRIVER=vercel-blob)
BLOB_READ_WRITE_TOKEN=""

# Mercado Pago — Pix
# Em produção, use credenciais de produção e a conta recebedora correta.
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_PUBLIC_KEY=""
# Segredo de assinatura do webhook (painel do Mercado Pago > Webhooks).
MERCADO_PAGO_WEBHOOK_SECRET=""
# ID do recebedor (collector_id) para validar a conta que recebeu o pagamento.
MERCADO_PAGO_COLLECTOR_ID=""
MERCADO_PAGO_ENV="sandbox"

# E-mail transacional (Resend). Opcional: sem chave, os e-mails não são enviados.
RESEND_API_KEY=""
EMAIL_FROM="Sua Loja <nao-responda@seudominio.com>"

# Exigir confirmação de e-mail antes do checkout.
REQUIRE_EMAIL_VERIFICATION="false"

# Não defina NODE_ENV manualmente na Vercel.
